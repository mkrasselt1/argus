# Copy to .env and adjust. All vars are optional.
APP_VERSION=dev

# Where the SQLite DB is stored inside the container (mounted volume).
SECSCAN_DATA_DIR=/data

# Full re-scan interval in minutes (0 disables the scheduler).
SECSCAN_SCAN_INTERVAL_MINUTES=360

# Web bind
SECSCAN_HOST=0.0.0.0
SECSCAN_PORT=8080

# Optional external scanner binaries (bundled trivy in the image by default).
SECSCAN_TRIVY_BIN=trivy
SECSCAN_SYFT_BIN=syft

# Agent/relay mode: set a strong shared secret ONLY on edge nodes that should
# accept collect requests from the central dashboard. Empty = agent disabled.
# The dashboard then uses a `relay` system with this token to reach devices
# that only the edge node can see (e.g. an isolated customer network via VPN).
SECSCAN_AGENT_TOKEN=
# Timeout (s) the dashboard waits for a relayed collect to return.
SECSCAN_RELAY_TIMEOUT=900

# Push/ingest mode (client -> server). Set a strong secret to enable /ingest.
# Clients then POST results with: python -m app.push --token <this>
SECSCAN_INGEST_TOKEN=
# Auto-create unknown systems on first push (1) or require them predefined (0).
SECSCAN_INGEST_AUTO_REGISTER=1

# Dev only: watch source files and reload the server on change.
SECSCAN_RELOAD=0

# Web UI login. Set a password to require login for the dashboard + management
# routes (ingest/enroll/agent keep their own tokens). Empty = no login.
SECSCAN_ADMIN_PASSWORD=
# Optional: fixed session-cookie secret (else derived from the password).
SECSCAN_SECRET_KEY=

# Key for module-credential encryption (Fernet key; else derived from secret).
SECSCAN_CRYPTO_KEY=
# Keep at most N scans per system (older pruned daily). 0 = unlimited.
SECSCAN_SCAN_RETENTION=20
